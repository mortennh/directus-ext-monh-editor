{
  "name": "monh-editor",
  "type": "module",
  "version": "1.0.1",
  "description": "TipTap rich-text editor for Directus with internal linking, file downloads and form embeds",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-interface"
  ],
  "icon": "extension",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "interface",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^10.10.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@tiptap/core": "^3.20.5",
    "@tiptap/extension-link": "^3.20.5",
    "@tiptap/extension-text-align": "^3.20.5",
    "@tiptap/extension-underline": "^3.20.5",
    "@tiptap/pm": "^3.20.5",
    "@tiptap/starter-kit": "^3.20.5",
    "@tiptap/vue-3": "^3.20.5",
    "@vueuse/core": "^14.2.1",
    "remixicon": "^4.9.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@directus/extensions-sdk": "17.1.0",
    "eslint": "^10.1.0",
    "typescript": "^6.0.2",
    "vue": "^3.5.31"
  }
}
